NEXT_PUBLIC_DASHBOARD_TITLE="NASDASH"

# Set these before the first production startup. If omitted, strong random
# passwords are generated and printed once in the application logs.
NASDASH_ADMIN_PASSWORD=
NASDASH_VIEWER_PASSWORD=

# Generate with: openssl rand -hex 32
# Keep this value stable: changing it invalidates sessions and prevents
# previously encrypted integration credentials from being decrypted.
NASDASH_JWT_SECRET=
# Optional isolated/advanced storage path. Defaults to <project>/data.
NASDASH_DATA_DIR=

# Public showcase only. Uses tracked fictional data and an isolated temporary
# sandbox while avoiding every connection to real infrastructure.
NASDASH_DEMO_MODE=false
