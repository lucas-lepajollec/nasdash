NEXT_PUBLIC_DASHBOARD_TITLE="NASDASH"

# Recommended for the first startup. If omitted, strong random passwords are
# generated and printed once in the application logs.
NASDASH_ADMIN_PASSWORD=
NASDASH_VIEWER_PASSWORD=

# Recommended in production to keep sessions and encrypted secrets stable.
NASDASH_JWT_SECRET=
# Optional isolated/advanced storage path. Defaults to <project>/data.
NASDASH_DATA_DIR=
