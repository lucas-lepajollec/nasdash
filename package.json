{
  "name": "nasdash",
  "version": "0.3.5",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1 --port 2499",
    "dev:lan": "next dev -H 0.0.0.0 --port 2499",
    "demo": "node scripts/demo-dev.mjs",
    "demo:lan": "node scripts/demo-dev.mjs --lan",
    "fake:integrations": "node scripts/fake-integrations.mjs",
    "demo:capture": "node scripts/capture-demo.mjs",
    "demo:docker": "docker compose -f docker-compose.demo.yml up --build -d",
    "demo:docker:start": "docker compose -f docker-compose.demo.yml up -d",
    "demo:docker:logs": "docker compose -f docker-compose.demo.yml logs -f --tail=100",
    "demo:docker:down": "docker compose -f docker-compose.demo.yml down",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "start:lan": "next start -H 0.0.0.0",
    "lint": "node scripts/lint-baseline.mjs",
    "lint:strict": "eslint",
    "check:version": "node scripts/check-version.mjs && node --test scripts/release-notes-tests.mjs",
    "check:i18n": "node scripts/check-i18n.mjs && node --test scripts/i18n-confirmation-tests.mjs && node scripts/check-installation-language.mjs",
    "check:installation-language": "node scripts/check-installation-language.mjs",
    "check:audit-policy": "node --test scripts/audit-policy-tests.mjs",
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "data:backup": "node scripts/data-snapshot.mjs backup",
    "data:restore": "node scripts/data-snapshot.mjs restore",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e-runner.mjs",
    "test:container": "node scripts/container-checks.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@vercel/analytics": "^2.0.1",
    "gridstack": "13.3.0",
    "ical.js": "2.2.1",
    "lucide-react": "^0.577.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "swr": "^2.5.1",
    "systeminformation": "^5.33.15",
    "uuid": "13.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@vitest/mocker": "4.1.12",
    "js-yaml": "4.3.2",
    "vite": "8.3.5"
  }
}
