  }

  .nd-dock-overlay {
    display: block !important;
    position: fixed !important;
    inset: 0 !important;
    background: rgba(0, 0, 0, 0.45) !important;
    z-index: 10001 !important;
    animation: nd-fade-in 0.2s ease-out;
  }

  .nd-dock-mobile-btn {
    position: fixed;
    top: 50%;
    transform: translateY(-50%);
    width: 28px;
    height: 64px;
    background: var(--nd-card-bg);
    border: 1px solid var(--nd-card-border);
    z-index: 10002 !important;
    display: flex !important;
    align-items: center;
    justify-content: center;
    color: var(--nd-text-muted);
    cursor: pointer;
    box-shadow: none;
    transition: left 0.3s cubic-bezier(0.4, 0, 0.2, 1), right 0.3s cubic-bezier(0.4, 0, 0.2, 1), background 0.2s;
  }

  .nd-dock-mobile-btn--left {
    left: 0;
    border-left: none;
    border-radius: 0 var(--nd-card-radius) var(--nd-card-radius) 0;
  }

  .nd-dock-mobile-btn--open.nd-dock-mobile-btn--left {
    left: 64px;
  }

  .nd-dock-mobile-btn--right {
