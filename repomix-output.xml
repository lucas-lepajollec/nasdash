  --nd-blue: #58a6ff;
  --nd-orange: #f0883e;
  --nd-green: #3fb950;
  --nd-red: #f85149;
  --nd-yellow: #d29922;

  --nd-progress-bg: rgba(255, 255, 255, 0.06);
  --nd-progress-fill: var(--nd-accent);

  --nd-blur: 12px;
  --nd-transition: 0.2s ease;

  --nd-sidebar-width: 230px;
  --nd-right-sidebar-width: 230px;
