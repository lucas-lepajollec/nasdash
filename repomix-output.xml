      <SortableContext items={devices.map(d => `drag-device-${d.id}`)} strategy={verticalListSortingStrategy}>
        <div style={{ display: 'flex', flexDirection: 'column', gap: 8 }}>
          {devices.map((device) => (
            <SortableDeviceCard
              key={device.id}
              device={device}
              editMode={editMode}
              onEdit={() => onEditDevice?.(device)}
