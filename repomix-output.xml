              </span>
            </button>

            {/* Configuration Widgets */}
            <button 
              onClick={() => setIsWidgetsMenuOpen(!isWidgetsMenuOpen)}
              style={{ 
                width: '100%',
                display: 'flex', 
                alignItems: 'center', 
                justifyContent: 'space-between',
                background: 'none',
                border: 'none',
                padding: '4px 4px',
                marginTop: 8,
                marginBottom: 4,
