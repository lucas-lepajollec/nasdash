.nd-settings-modal {
  width: 1100px !important;
  max-width: 95vw !important;
  height: 750px !important;
  max-height: 90vh !important;
  display: flex !important;
  flex-direction: row !important;
  padding: 0 !important;
  overflow: hidden !important;
