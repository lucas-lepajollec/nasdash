  }
}

/* Actions Visibility */
.nd-mobile-actions {
  display: none !important;
}
.nd-mobile-menu {
  display: none !important;
}
.nd-header-mobile {
  display: none !important;
}
.nd-header-desktop {
  display: flex !important;
}

@media (max-width: 960px) {
  .nd-header-menu {
    display: none !important;
  }

  .nd-header {
    position: relative;
    gap: 8px;
    padding: 12px 20px;
    margin-bottom: 8px;
  }

  .nd-header-actions {
    flex: 0 0 auto;
  }

