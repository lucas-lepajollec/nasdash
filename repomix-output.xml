  animation: weatherFloat 4s ease-in-out infinite;
}

.weather-anim-rain {
  animation: weatherRainDrop 1.5s ease-in-out infinite;
}

.weather-anim-snow {
  animation: weatherFloatSlow 3s ease-in-out infinite;
}

.weather-anim-storm {
  animation: weatherFlash 4s infinite, weatherFloat 3s ease-in-out infinite;
}

.weather-glow {
  transition: box-shadow 0.5s ease;
  animation: weatherGlowPulse 4s ease-in-out infinite;
}
