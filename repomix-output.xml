                <span style={{ fontSize: '0.8rem', fontWeight: 600, color: 'var(--nd-text)' }}>Général</span>
              </div>
            </button>
          </div>
        </div>

        {/* Category: Paramètres Spécifiques */}
        <div className="nd-settings-sidebar-group">
          <button 
            onClick={() => setIsTabsMenuOpen(!isTabsMenuOpen)}
