@import "tailwindcss";

/* ============================================================
   NASDASH v2 — GLANCE-INSPIRED DESIGN SYSTEM
   Style: Information-dense, terminal-inspired, dark cyberpunk
   Font: Outfit
   ============================================================ */

:root {
  --nd-bg: #0d1117;
  --nd-bg-surface: #161b22;
  --nd-bg-gradient: radial-gradient(ellipse at top center, #161b22 0%, #0d1117 70%);

  --nd-card-bg-rgb: 22, 27, 34;
