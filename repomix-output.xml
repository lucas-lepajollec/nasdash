  top: 2px;
  right: 2px;
  padding: 1px;
}

/* ==================== CARD TRANSPARENCY OVERRIDE ==================== */
/* Remove residual frosted glass blur behind dashboard cards and sidebars for clean, consistent glassmorphism */
.nd-card, .nd-sidebar-card {
  backdrop-filter: none !important;
  -webkit-backdrop-filter: none !important;
}


/* ==================== TITLE ANIMATIONS & RESPONSIVE ==================== */
.nd-title-desktop { display: inline; }
.nd-title-tablet { display: none; }
.nd-title-mobile { display: none; }

@media (max-width: 1024px) {
  .nd-title-desktop { display: none; }
  .nd-title-tablet { display: inline; }
}

@media (max-width: 640px) {
  .nd-title-tablet { display: none; }
  .nd-title-desktop { display: none; }
  .nd-title-mobile { display: inline; }
}

/* Balayage Lumineux Premium & Adaptatif (Spotlight) */
@keyframes spotlightSweep {
  0% { background-position: 200% center; }
  100% { background-position: -200% center; }
}

/* Spotlight Silver: Métallique Premium */
.nd-title-anim-spotlight-silver strong {
  background: linear-gradient(
    110deg,
    var(--nd-text-muted) 35%,
    var(--nd-text) 50%,
    var(--nd-text-muted) 65%
  );
  background-size: 200% auto;
  color: transparent;
  -webkit-background-clip: text;
  background-clip: text;
  animation: spotlightSweep 3.5s linear infinite;
}

/* ============================================================
   WEATHER ANIMATIONS
   ============================================================ */

@keyframes weatherFloat {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-4px); }
}

@keyframes weatherFloatSlow {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-2px); }
}

@keyframes weatherSpin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

@keyframes weatherRainDrop {
  0% { transform: translateY(-2px); opacity: 0.8; }
  50% { transform: translateY(3px); opacity: 1; }
  100% { transform: translateY(-2px); opacity: 0.8; }
}

@keyframes weatherFlash {
  0%, 100% { opacity: 1; }
  5% { opacity: 0.4; }
  10% { opacity: 1; }
  15% { opacity: 0.4; }
  20% { opacity: 1; }
}

@keyframes weatherGlowPulse {
  0%, 100% { opacity: 0.6; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.1); }
}

.weather-anim-sun {
  animation: weatherSpin 20s linear infinite;
}

