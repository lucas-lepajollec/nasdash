}

/* ==================== BASE ==================== */
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
  color-scheme: dark;
}

.light {
  color-scheme: light;
}

body {
  font-family: 'Outfit', sans-serif;
  background-color: var(--nd-bg);
  background-image: var(--nd-bg-gradient);
  background-attachment: fixed;
  color: var(--nd-text);
  min-height: 100vh;
  -webkit-font-smoothing: antialiased;
}

/* ==================== 3-COLUMN LAYOUT ==================== */
