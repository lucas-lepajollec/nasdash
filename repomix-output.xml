  display: grid;
  grid-template-columns: var(--nd-sidebar-width) minmax(0, 1fr) var(--nd-right-sidebar-width);
  gap: 24px;
  max-width: 1600px;
  margin: 0 auto;
  padding: 0 20px 40px;
  align-items: start;
}

.nd-sidebar-left {
  position: sticky;
  top: 20px;
  display: flex;
  flex-direction: column;
  gap: 16px;
  max-height: calc(100vh - 100px);
  overflow-y: auto;
}

.nd-center {
  min-width: 0;
}

.nd-sidebar-right {
  position: sticky;
  top: 20px;
  display: flex;
  flex-direction: column;
  gap: 16px;
  max-height: calc(100vh - 100px);
  overflow-y: auto;
}

/* ==================== HEADER ==================== */
.nd-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 16px 20px;
  max-width: 1600px;
  width: 100%;
  margin: 0 auto 16px auto;
  flex-shrink: 0;
}

.nd-header-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 6px;
  flex: 1;
}

.nd-header-edit-row {
  display: flex;
  align-items: center;
  gap: 6px;
}

.nd-brand {
  font-size: 0.85rem;
  font-weight: 500;
  font-family: 'JetBrains Mono', 'Fira Code', monospace;
  color: var(--nd-text-muted);
  display: flex;
  align-items: center;
  gap: 8px;
  white-space: nowrap;
  flex: 1;
  /* Pushes search to center */
}

/* Operational LED Indicator Dot */
.nd-brand-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--nd-green);
  box-shadow: 0 0 6px var(--nd-green);
  animation: nd-pulse-dot 2.5s ease-in-out infinite;
  display: inline-block;
  flex-shrink: 0;
}

@keyframes nd-pulse-dot {
  0%, 100% {
    opacity: 1;
    transform: scale(1);
    box-shadow: 0 0 6px var(--nd-green);
  }
  50% {
    opacity: 0.4;
    transform: scale(0.9);
    box-shadow: 0 0 2px var(--nd-green);
  }
}

.nd-brand strong {
  color: var(--nd-text);
  font-weight: 700;
}

.nd-nav-tabs {
  display: flex;
  align-items: center;
  gap: 2px;
  background: var(--nd-card-bg);
  border: 1px solid var(--nd-card-border);
  border-radius: var(--nd-card-radius);
  padding: 3px;
}

.nd-nav-tab {
  padding: 6px 14px;
  border-radius: calc(var(--nd-card-radius) * 0.6);
  font-size: 0.75rem;
  font-weight: 500;
  color: var(--nd-text-muted);
  background: none;
  border: none;
  cursor: pointer;
  transition: background var(--nd-transition), color var(--nd-transition);
}

.nd-nav-tab:hover {
  color: var(--nd-text);
  background: rgba(255, 255, 255, 0.04);
}

.nd-nav-tab-active {
  color: var(--nd-text);
  background: rgba(255, 255, 255, 0.08);
}

.light .nd-nav-tab:hover {
  background: rgba(0, 0, 0, 0.04);
}

.light .nd-nav-tab-active {
  background: #ffffff;
  color: #1d1d1f;
  box-shadow: none;
}

.nd-search {
  flex: 1;
  max-width: 340px;
  position: relative;
}

.nd-search input {
  width: 100%;
  height: 36px;
  padding: 0 12px 0 34px;
  border-radius: var(--nd-card-radius);
  background: var(--nd-card-bg);
  border: 1px solid var(--nd-card-border);
  color: var(--nd-text);
  font-size: 0.8rem;
  font-family: 'Outfit', sans-serif;
  outline: none;
  transition: border-color var(--nd-transition);
  box-sizing: border-box;
}

.nd-search input::placeholder {
  color: var(--nd-text-dimmed);
}

.nd-search input:focus {
  border-color: var(--nd-accent);
}

.nd-search-icon {
  position: absolute;
  left: 10px;
  top: 50%;
  transform: translateY(-50%);
  color: var(--nd-text-dimmed);
  pointer-events: none;
}

/* ==================== iOS SAFARI PATCH ==================== */
/* Fixes auto-zoom on mobile when focusing inputs */
@media (max-width: 768px) {
  input, textarea, select {
    font-size: 16px !important;
  }
}

.nd-btn {
  padding: 0 12px;
  border-radius: var(--nd-card-radius);
  border: 1px solid var(--nd-card-border);
  background: var(--nd-card-bg);
  color: var(--nd-text-muted);
  cursor: pointer;
  transition: background var(--nd-transition), color var(--nd-transition), border-color var(--nd-transition), transform var(--nd-transition);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 5px;
  font-size: 0.72rem;
  font-weight: 600;
  font-family: inherit;
  height: 36px;
  box-sizing: border-box;
}

.nd-btn:hover {
  color: var(--nd-text);
  background: var(--nd-card-bg);
  border-color: var(--nd-card-hover-border);
  filter: brightness(1.1);
}

.nd-btn-active {
  background: var(--nd-accent) !important;
  border-color: var(--nd-accent) !important;
  color: #000 !important;
}

.nd-btn-accent {
  background: var(--nd-accent);
  border-color: var(--nd-accent);
  color: #000;
  font-weight: 700;
}

.nd-btn-accent:hover {
  opacity: 0.9;
}

/* Enhanced Distinct Hitboxes for Edit Icons */
.nd-action-icon {
  background: transparent;
  border: 1px solid var(--nd-card-border);
  color: var(--nd-text-muted);
  cursor: pointer;
  width: 26px;
  height: 26px;
  padding: 0;
  margin: 0;
  border-radius: calc(var(--nd-card-radius) * 0.5);
  transition: all var(--nd-transition);
  display: flex;
  align-items: center;
  justify-content: center;
}

.nd-action-icon:hover {
  background: rgba(255, 255, 255, 0.06);
  border-color: var(--nd-text-muted);
  color: var(--nd-text);
}

/* + Add buttons → GREEN */
.nd-action-icon.success { color: var(--nd-green); border-color: color-mix(in srgb, var(--nd-green) 30%, transparent); }
.nd-action-icon.success:hover { background: color-mix(in srgb, var(--nd-green) 15%, transparent); border-color: var(--nd-green); color: var(--nd-green); }

/* Pencil/Edit buttons → BLUE */
.nd-action-icon.accent { color: var(--nd-blue); border-color: color-mix(in srgb, var(--nd-blue) 30%, transparent); }
.nd-action-icon.accent:hover { background: color-mix(in srgb, var(--nd-blue) 15%, transparent); border-color: var(--nd-blue); color: var(--nd-blue); }

/* Trash/Delete buttons → RED */
.nd-action-icon.danger { color: var(--nd-red); border-color: color-mix(in srgb, var(--nd-red) 30%, transparent); }
.nd-action-icon.danger:hover { background: color-mix(in srgb, var(--nd-red) 15%, transparent); border-color: var(--nd-red); color: var(--nd-red); }

/* ==================== SECRET BANNER ==================== */
.nd-secret-banner {
  background: rgba(248, 81, 73, 0.08);
  border: 1px solid rgba(248, 81, 73, 0.2);
  border-radius: var(--nd-card-radius);
  padding: 8px 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 1px;
  text-transform: uppercase;
  color: var(--nd-red);
  width: calc(100% - 40px);
  max-width: calc(1600px - 40px);
  margin: -10px auto 26px auto;
  animation: nd-fade-in 0.3s ease-out;
}

/* ==================== SECTION TITLE (Terminal-style) ==================== */
.nd-section-title {
  font-size: 0.7rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  color: var(--nd-text-muted);
  padding-bottom: 8px;
  margin-bottom: 8px;
  border-bottom: 1px solid var(--nd-card-border);
  display: flex;
  align-items: center;
  gap: 6px;
}

.nd-section-emoji {
  font-size: 0.85rem;
}

/* ==================== SIDEBAR CARD ==================== */
.nd-sidebar-card {
  background: var(--nd-card-bg);
  border: 1px solid var(--nd-card-border);
  border-radius: var(--nd-card-radius);
  padding: 14px;
}

/* ==================== STAT ROW ==================== */
.nd-stat-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 4px 0;
  font-size: 0.78rem;
}

.nd-stat-label {
  color: var(--nd-text-muted);
  font-weight: 500;
  display: flex;
  align-items: center;
  gap: 6px;
}

.nd-stat-label-detail {
  font-size: 0.65rem;
  color: var(--nd-text-dimmed);
}

.nd-stat-value {
  font-weight: 700;
  color: var(--nd-text);
  font-variant-numeric: tabular-nums;
}

.nd-stat-accent {
  color: var(--nd-accent);
}

/* ==================== PROGRESS BAR ==================== */
.nd-progress {
  width: 100%;
  height: 6px;
  background: var(--nd-progress-bg);
  border-radius: 99px;
  overflow: hidden;
  margin-top: 3px;
}

.nd-progress-fill {
  height: 100%;
  border-radius: 99px;
  background: var(--nd-accent);
  transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1);
}

.nd-progress-warn {
  background: var(--nd-yellow);
}

.nd-progress-danger {
  background: var(--nd-red);
}

.nd-progress-orange {
  background: var(--nd-orange);
}

.nd-progress-green {
  background: var(--nd-green);
}

.nd-progress-blue {
  background: var(--nd-accent);
}

.nd-progress-purple {
  background: var(--nd-purple);
}

/* ==================== CATEGORY CARD ==================== */


.nd-dock {
  background: var(--nd-card-bg);
  border: 1px solid var(--nd-card-border);
  border-radius: var(--nd-card-radius);
  padding: 12px;
  display: flex;
  flex-direction: column;
  gap: 16px;
  box-shadow: var(--nd-card-shadow);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  z-index: 40;
}

/* Hide the dock on mobile devices */
@media (max-width: 768px) {
  .nd-dock-portal, .nd-dock {
    display: none !important;
  }
}

.nd-card {
  background: var(--nd-card-bg);
  border: 1px solid var(--nd-card-border);
  border-radius: var(--nd-card-radius);
  padding: 14px;
  box-shadow: var(--nd-card-shadow);
  transition: border-color var(--nd-transition);
}

.nd-card:hover {
  border-color: var(--nd-card-hover-border);
}

.nd-category-title {
  font-size: 0.7rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  color: var(--nd-text-muted);
  padding-bottom: 10px;
  margin-bottom: 6px;
  border-bottom: 1px solid var(--nd-card-border);
  display: flex;
  align-items: center;
  gap: 6px;
}

.nd-category-emoji {
  font-size: 0.85rem;
}

/* ==================== SERVICE ITEM ==================== */
.nd-service {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 7px 8px;
  border-radius: calc(var(--nd-card-radius) * 0.7);
  border: 1px solid transparent;
  transition: background var(--nd-transition), border-color var(--nd-transition);
  text-decoration: none;
  color: inherit;
}

.nd-service:hover {
  background: rgba(255, 255, 255, 0.03);
  border-color: var(--nd-card-border);
}

.light .nd-service:hover {
  background: rgba(0, 0, 0, 0.03);
}

.nd-service-icon {
  width: 34px;
  height: 34px;
  border-radius: calc(var(--nd-card-radius) * 0.7);
  background: var(--nd-icon-bg);
  border: 1px solid var(--nd-icon-border);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}

.nd-service-icon img {
  width: 22px;
  height: 22px;
  object-fit: contain;
}

.nd-service-icon-fallback {
  font-size: 13px;
  font-weight: 700;
  color: var(--nd-accent);
}

.nd-service-name {
  font-weight: 600;
  font-size: 0.82rem;
  color: var(--nd-text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.nd-service-url {
  font-size: 0.62rem;
  color: var(--nd-text-dimmed);
  font-family: 'JetBrains Mono', 'Fira Code', monospace;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.nd-vpn-btn {
  width: 28px;
  height: 28px;
  border-radius: calc(var(--nd-card-radius) * 0.5);
  background: rgba(0, 0, 0, 0.2);
  border: 1px solid var(--nd-card-border);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: border-color var(--nd-transition);
  flex-shrink: 0;
  color: var(--nd-text-muted);
  opacity: 0.4;
}

.nd-vpn-btn:hover {
  border-color: var(--nd-accent);
  opacity: 1;
  color: var(--nd-accent);
}

/* ==================== EDIT BUTTONS ==================== */
.nd-edit-btn {
  padding: 4px;
  border-radius: calc(var(--nd-card-radius) * 0.4);
  border: none;
  background: transparent;
  cursor: pointer;
  transition: background var(--nd-transition);
  display: flex;
  align-items: center;
  justify-content: center;
}

.nd-edit-btn:hover {
  background: rgba(255, 255, 255, 0.06);
}

.nd-edit-btn-danger:hover {
  background: rgba(248, 81, 73, 0.12);
}

/* ==================== MONITOR ==================== */
.nd-monitor-title {
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  font-weight: 700;
  color: var(--nd-text-muted);
  display: flex;
  align-items: center;
  gap: 6px;
  padding-left: 10px;
  border-left: 3px solid var(--nd-accent);
  margin-bottom: 12px;
}

/* ==================== FOOTER ==================== */
.nd-port-pill {
  display: inline-block;
  font-family: 'JetBrains Mono', 'Fira Code', monospace;
  font-size: 0.62rem;
  padding: 2px 6px;
  border-radius: var(--nd-card-radius);
  background: var(--nd-card-bg);
  color: var(--nd-text-muted);
  border: 1px solid var(--nd-card-border);
  transition: border-color var(--nd-transition), color var(--nd-transition), transform var(--nd-transition);
}

.nd-port-pill:hover {
  border-color: var(--nd-accent);
  color: var(--nd-accent);
  transform: scale(1.05);
}

/* ==================== MODAL ==================== */
.nd-modal-overlay {
  position: fixed;
  inset: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16px;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(6px);
  animation: nd-fade-in 0.15s ease-out;
}

.nd-modal {
  width: 100%;
  max-width: 420px;
  max-height: 90svh;
  overflow-y: auto;
  overscroll-behavior: contain;
  background: var(--nd-bg-surface);
  border: 1px solid var(--nd-card-border);
  border-radius: var(--nd-card-radius);
  padding: 20px;
  box-shadow: none;
}

.nd-input {
  width: 100%;
  padding: 8px 12px;
  border-radius: var(--nd-card-radius);
  background: rgba(0, 0, 0, 0.2);
  border: 1px solid var(--nd-card-border);
  color: var(--nd-text);
  font-family: 'Outfit', sans-serif;
  font-size: 0.82rem;
  outline: none;
  transition: border-color var(--nd-transition);
}

.light .nd-input {
  background: rgba(0, 0, 0, 0.03);
}

.nd-input:focus {
  border-color: var(--nd-accent);
}

.nd-input::placeholder {
  color: var(--nd-text-dimmed);
}

.nd-label {
  font-size: 0.65rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 1px;
  color: var(--nd-text-muted);
  margin-bottom: 5px;
  display: block;
}

/* ==================== RIGHT SIDEBAR ITEMS ==================== */
.nd-ts-device {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 5px 0;
  font-size: 0.75rem;
}

.nd-ts-device-name {
  font-weight: 600;
  color: var(--nd-text);
}

.nd-ts-device-os {
  font-size: 0.62rem;
  color: var(--nd-text-dimmed);
}

.nd-ts-status {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--nd-green);
  box-shadow: 0 0 4px var(--nd-green);
  flex-shrink: 0;
}

/* ==================== ANIMATIONS ==================== */
@keyframes nd-fade-in {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

@keyframes nd-fade-up {
  from {
    opacity: 0;
    transform: translateY(12px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes spin {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

.nd-animate-in {
  animation: nd-fade-up 0.4s ease-out both;
}

.nd-stagger-1 {
  animation-delay: 0.05s;
}

.nd-stagger-2 {
  animation-delay: 0.1s;
}

.nd-stagger-3 {
  animation-delay: 0.15s;
}

/* ==================== SCROLLBAR ==================== */
::-webkit-scrollbar {
  width: 4px;
}

::-webkit-scrollbar-track {
  background: transparent;
}

::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.06);
  border-radius: 99px;
}

::-webkit-scrollbar-thumb:hover {
  background: rgba(255, 255, 255, 0.12);
}

/* ==================== RESPONSIVE ==================== */
@media (max-width: 960px) {
  .nd-layout {
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }

  .nd-center {
    width: 100%;
  }

  .nd-sidebar-left,
