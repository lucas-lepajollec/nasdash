                if (isDisk) {
                  const match = shortLabel.match(/\(([^)]+)\)/);
                  if (match) shortLabel = match[1];
                  else shortLabel = shortLabel.replace(/disque|disk/i, '').trim();
                }

                let cleanValue = stat.value.replace(/\d+(?:[.,]\d+)?\s*%/, '').trim();
