# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/backups/
/.e2e/
/playwright-report/
/test-results/

# next.js
/.next/
/.next-e2e/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Custom Data — only *.example.json and .gitkeep are committed;
# all real data files (which may contain tokens, password hashes, topology, etc.) are local-only.
data/*
!data/*.example.json
data/.env
data/logos/*
!data/logos/.gitkeep

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local context (not for GitHub)
roadmap.md
context.md
commandes.md

# real data (local-only)
/data-real/

# test data generated locally
/data_test*/
/data_test_crypto_temp

# agent configs
.agents/
